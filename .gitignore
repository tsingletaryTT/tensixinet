# Generated output
/audio/
logs/
__pycache__/
.pytest_cache/
*.pyc

# Local scratch and backups (archive/ holds editor backups and memory snapshots)
archive/

# tt-metal's own runtime cache (device topology, kernel compile logs): written into the working
# directory as a side effect of running a kernel, not project source, and it names the host and ASIC IDs.
generated/
build/
videos/
input.mp4
demo_output.mp4

# Demo recordings are large. Ignore everything under demo/assets except the final cut and its contact sheet.
demo/assets/*
!demo/assets/chorus.final.mp4
!demo/assets/chorus.sheet.png
!demo/assets/features.final.mp4
!demo/assets/features.sheet.png
!demo/assets/kernels.final.mp4
!demo/assets/kernels.sheet.png
!demo/assets/stereo.final.mp4
!demo/assets/stereo.sheet.png
!demo/assets/hardware/
!demo/assets/hardware/kernels_on_chip0.mp4
!demo/assets/hardware/kernels_on_chip0.sheet.png
.venv-app/
*.egg-info/
